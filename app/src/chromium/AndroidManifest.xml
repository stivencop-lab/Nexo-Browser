<?xml version="1.0" encoding="utf-8"?>
<!--
    Variante Chromium. WebView usa la política de red de Android: sin esto
    no abriría ningún sitio http:// (net::ERR_CLEARTEXT_NOT_PERMITTED), cosa
    que con Gecko no ocurre porque Gecko tiene su propia red. Los servicios
    propios de Nexo siguen usando solo direcciones https validadas.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
